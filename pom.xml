<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 注意：必须停留在 3.5.x。
             Spring AI Alibaba 1.1.2.x 仅支持 Spring Boot 3.5 + Spring AI 1.1.4，
             升到 4.0.x 会出现 RestClientAutoConfiguration ClassNotFound（包路径迁移所致）。
             官方计划 2026/06 之后才发布支持 Spring Boot 4 / Spring AI 2 的版本。 -->
        <version>3.5.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.yuyu</groupId>
    <artifactId>Fish-Agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Fish-Agent</name>
    <description>Fish-Agent</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- 与 spring-ai-alibaba 1.1.2.0 对齐的 Spring AI 核心版本（见根注释） -->
        <spring-ai.version>1.1.4</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Redis 访问能力：用于缓存、限流令牌、分布式锁等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Elasticsearch 集成：用于关键词检索与向量检索（SB 3.x 命名为 data-elasticsearch） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <!-- Web MVC：提供 REST 接口与流式响应能力（SB 3.x 命名为 web） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Actuator：暴露 health/prometheus，并自动绑定 JVM/HTTP/Cache/Resilience4j 指标。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- @Observed AOP 切面需要 AspectJ runtime；版本由 Spring Boot BOM 管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- Prometheus 抓取端点：/actuator/prometheus。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Spring AI 阿里云 Agent 框架：用于智能体编排与工具调用 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>1.1.2.0</version>
        </dependency>

        <!-- DashScope 模型接入：提供通义系列模型的 ChatModel 能力 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>1.1.2.0</version>
        </dependency>
        <!-- 本地 Ollama ChatModel：与 DashScope 二选一由 spring.ai.model.chat + fish.llm.chat-provider 控制 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- DeepSeek / OpenAI 兼容接口：spring.ai.openai.base-url 指向 DeepSeek API，fish.llm.chat-provider=DEEPSEEK 时启用 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- MySQL 驱动：运行时连接关系型数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MyBatis-Plus（Spring Boot 3）：实体映射与 BaseMapper -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.9</version>
        </dependency>
        <!-- RustFS / MinIO：S3 兼容对象存储客户端 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>
        <!-- 仅引入加密模块：BCrypt 密码哈希，不拉取完整 Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- Lombok：减少样板代码（getter/setter/构造器等）。
             scope=provided：仅编译期需要；annotation processor 由下方 maven-compiler-plugin 显式启用。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
        <!-- 通用测试支持：包含 JUnit 5 / AssertJ / Mockito / Spring Test / WebMvcTest 等。
             SB 3.x 把测试支持统一到一个 starter，不再像 SB 4 那样按场景拆分。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 邮件发送：MailTool 工具使用，基于 JavaMailSender 自动装配 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Jsoup：WebFetchTool 解析 HTML 网页正文 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>
        <!-- Resilience4j：外部服务熔断，保护 LLM / ES / Reranker 调用链 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <!-- 同步调用熔断器核心 API：CircuitBreakerRegistry / executeSupplier 等 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.2.0</version>
        </dependency>
        <!-- Reactor Flux 熔断 Operator：用于保护 ChatAgent.stream() 的完整流式生命周期 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>2.2.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式声明 Lombok annotation processor。
                 SB 3.5.x 的 starter-parent 默认已经配好处理器，这里冗余声明是为了：
                 1) 命令行 mvn 在不同环境下行为更确定；
                 2) 未来若升级到 Spring Boot 4.x（默认行为变化）能直接生效。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

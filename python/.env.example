# Redis（与 Spring Boot spring.data.redis 对齐）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2

# RustFS / MinIO（与 fish.rustfs 对齐）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=<your-rustfs-access-key>
RUSTFS_SECRET_KEY=<your-rustfs-secret-key>
RUSTFS_BUCKET_DOCS=fish-docs

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# MySQL：二选一（优先解析 DB_URL）
DB_URL=jdbc:mysql://localhost:3306/fish_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=<your-db-password>
# 若不使用 DB_URL，可拆开：
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fish_agent

# Stream / 索引（与 application.yml 对齐）
FISH_DOC_INGEST_STREAM=fish:doc:ingest
# MEMORY_USER_INDEX：对话长期事实（Java 写入）；Worker 不写此索引
MEMORY_USER_INDEX=fish-user-memory
# KNOWLEDGE_USER_INDEX：用户上传文档切片（PRIVATE）；与 fish.knowledge.user-knowledge-index-name 一致
KNOWLEDGE_USER_INDEX=fish-user-knowledge
KNOWLEDGE_PUBLIC_INDEX=fish-public-knowledge

# 嵌入（与 fish.llm.embedding 对齐）
FISH_LLM_EMBEDDING_PROVIDER=DASHSCOPE
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_EMBEDDING_DIMENSIONS=1536

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Worker 专属
FISH_WORKER_CONSUMER_GROUP=fish-doc-worker-group
FISH_WORKER_CONCURRENCY=2
FISH_WORKER_CHUNK_SIZE=512
FISH_WORKER_CHUNK_OVERLAP=50
FISH_WORKER_ES_BATCH_SIZE=20
FISH_WORKER_DASHSCOPE_EMBED_BATCH=25
FISH_WORKER_BLOCK_MS=5000
FISH_WORKER_HEALTH_PORT=8091

# ── 本地开发敏感配置模板 ──
# 复制此文件为 application-dev.yml 并填入你的真实凭据
# cp application-dev.yml.example application-dev.yml
#
# 启动时激活 dev profile：
#   IDEA: VM options 添加 -Dspring.profiles.active=dev
#   命令行: --spring.profiles.active=dev
#   环境变量: SPRING_PROFILES_ACTIVE=dev

spring:
  ai:
    openai:
      api-key: <your-deepseek-api-key>
  datasource:
    password: <your-db-password>

fish:
  tools:
    tavily:
      api-key: <your-tavily-api-key>
    bocha:
      api-key: <your-bocha-api-key>
    amap:
      key: <your-amap-key>
  rustfs:
    access-key: <your-rustfs-access-key>
    secret-key: <your-rustfs-secret-key>
